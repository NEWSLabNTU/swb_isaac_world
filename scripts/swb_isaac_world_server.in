#!/usr/bin/env bash
# swb's Isaac Sim world server as a launch node (roadmap 043; swb_isaac_world.launch.xml).
#
#   swb_isaac_world_server --port N --ego <yaml|none> [--ego-domain N] --world <worlds|none>
#                      --follow <true|false|editor> --render <auto|window|headless> [--record=<dir>]
#                      [--record-view <offroad|road>] [--physics-hz <Hz>]
#                      [--state-dir=<dir>] [--wheels-topic <true|false>]
#                      [--ros-args ...]
#
# The world server is Python 3.12 in Isaac's venv with Isaac's own ROS 2 libraries
# (scripts/isaac_env.sh); the system Humble a launch runs under must not leak
# into it, so its paths are dropped here first. The launch's --ros-args (node name, remaps)
# mean nothing to it and are dropped too. The ego is aib's (autoware_isaac_bridge, the
# submodule at deps/autoware_isaac_bridge; roadmap 045): isaac_env.sh puts its package on
# PYTHONPATH, and --ego default is its config/ego.yaml.
#
# Environment: SWB_ISAAC_DIR (default: the source tree this package was built from),
# ISAAC_ROOT, DISPLAY (render auto/window), ISAAC_HEADLESS=1 (render auto: headless),
# CYCLONEDDS_URI (passed through: the ego stack's DDS), SWB_CARLA_USD (the CARLA USD set's
# root, for world files that name it and course worlds' props; passed through).
set -e
swb_isaac_world="${SWB_ISAAC_DIR:-@SWB_ISAAC_DIR@}"
aib_ego="$swb_isaac_world/deps/autoware_isaac_bridge/src/aib/config/ego.yaml"
port=5590; ego=default; ego_domain=0; world=none; follow=false; render=auto; record=""; record_view=offroad; physics_hz=60
state_dir=""; wheels_topic=true
while [ $# -gt 0 ]; do
    case "$1" in
        --ros-args) break ;;
        --port) port="$2"; shift 2 ;;
        --ego) ego="$2"; shift 2 ;;
        --ego-domain) ego_domain="$2"; shift 2 ;;
        --world) world="$2"; shift 2 ;;
        --follow) follow="$2"; shift 2 ;;
        --render) render="$2"; shift 2 ;;
        --record=*) record="${1#--record=}"; shift ;;
        --record-view) record_view="$2"; shift 2 ;;
        --physics-hz) physics_hz="$2"; shift 2 ;;
        --state-dir=*) state_dir="${1#--state-dir=}"; shift ;;
        --wheels-topic) wheels_topic="$2"; shift 2 ;;
        *) echo "swb_isaac_world_server: unknown argument '$1'" >&2; exit 2 ;;
    esac
done

args=(--port "$port")
case "$ego" in
    default) args+=(--ego "$aib_ego") ;;
    none|"") ;;
    *) args+=(--ego "$ego") ;;
esac
case "$ego_domain" in 0|"") ;; *) args+=(--ego-domain "$ego_domain") ;; esac
case "$world" in none|"") ;; *) args+=(--world "$world") ;; esac
case "$follow" in
    true|1) args+=(--follow) ;;
    editor) args+=(--follow --ui) ;;
    false|0) ;;
    *) echo "swb_isaac_world_server: follow '$follow' is not true, false or editor" >&2; exit 2 ;;
esac
[ -n "$record" ] && args+=(--record "$record" --record-view "$record_view")
args+=(--physics-hz "$physics_hz")
[ -n "$state_dir" ] && args+=(--state-dir "$state_dir")
case "$wheels_topic" in
    true|1) ;;
    false|0) args+=(--wheels-topic false) ;;
    *) echo "swb_isaac_world_server: wheels_topic '$wheels_topic' is not true or false" >&2; exit 2 ;;
esac
display="${DISPLAY:-}"
case "$render" in
    auto) [ -n "${ISAAC_HEADLESS:-}" ] && [ "${ISAAC_HEADLESS}" != 0 ] && display="" ;;
    window) [ -n "$display" ] || { echo "swb_isaac_world_server: render window needs DISPLAY" >&2; exit 2; } ;;
    headless) display="" ;;
    *) echo "swb_isaac_world_server: render '$render' is not auto, window or headless" >&2; exit 2 ;;
esac
[ -n "$display" ] && args+=(--display "$display")

# The system ROS 2 environment out, Isaac's in.
unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH \
    COLCON_PREFIX_PATH PKG_CONFIG_PATH ROS_PACKAGE_PATH ROS_LOCALHOST_ONLY ROS_VERSION \
    ROS_PYTHON_VERSION VIRTUAL_ENV
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v '^/opt/ros/\|^/opt/autoware/\|/install/' | paste -sd:)
export ISAAC_ROOT="${ISAAC_ROOT:-/mnt/disk1/isaac-sim}"
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# shellcheck source=/dev/null
source "$swb_isaac_world/scripts/isaac_env.sh"
cd "$swb_isaac_world"
echo "swb_isaac_world_server: python -m swb_isaac_world.world_server ${args[*]}"
exec python -u -m swb_isaac_world.world_server "${args[@]}"
